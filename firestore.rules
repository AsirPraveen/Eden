rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the requester is a member of the given clinic
    function isClinicMember(clinicId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/clinics/$(clinicId)/members/$(request.auth.uid));
    }

    // Helper: check if the requester is the clinic owner
    function isClinicOwner(clinicId) {
      return request.auth != null
        && get(/databases/$(database)/documents/clinics/$(clinicId)/members/$(request.auth.uid)).data.role == 'owner';
    }

    // Users can read/write their own profile
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Clinic document — members can read, only owner can update
    match /clinics/{clinicId} {
      allow read: if isClinicMember(clinicId);
      allow create: if request.auth != null;
      allow update, delete: if isClinicOwner(clinicId);

      // Members subcollection
      match /members/{memberId} {
        allow read: if isClinicMember(clinicId);
        allow write: if isClinicOwner(clinicId) || request.auth.uid == memberId;
      }

      // All clinic data subcollections — members can read/write
      match /medicines/{docId} {
        allow read, write: if isClinicMember(clinicId);
      }

      match /stockEntries/{docId} {
        allow read, write: if isClinicMember(clinicId);
      }

      match /patients/{docId} {
        allow read, write: if isClinicMember(clinicId);
      }

      match /prescriptions/{docId} {
        allow read, write: if isClinicMember(clinicId);
      }

      match /reps/{docId} {
        allow read, write: if isClinicMember(clinicId);
      }

      match /payments/{docId} {
        allow read, write: if isClinicMember(clinicId);
      }

      match /analytics/{docId} {
        allow read: if isClinicMember(clinicId);
        allow write: if isClinicMember(clinicId);
      }
    }
  }
}
